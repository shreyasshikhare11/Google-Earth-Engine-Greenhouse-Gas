/**
 * City-Scale Multi-Gas Dashboard — Monthly Time Series
 * QA strategy:
 *   CH4  → solar_zenith_angle < 70
 *   CO   → solar_zenith_angle < 70
 *   NO2  → cloud_fraction < 0.3
 *   HCHO → cloud_fraction < 0.3
 */

// ── 1. CONFIGURATION ─────────────────────────────────────────────────────────
var CONFIG = {
  lat:          51.5,
  lon:          -0.1344,
  cityName:     'London',
  bufferMeters: 20000,
  startDate:    '2024-01-01',
  endDate:      '2026-01-01',
  chartScale:   5000,
  exportScale:  10000,
};

var roi = ee.Geometry.Point([CONFIG.lon, CONFIG.lat]).buffer(CONFIG.bufferMeters);
Map.centerObject(roi, 11);
Map.setOptions('HYBRID');

// ── 2. QA FILTER FUNCTIONS ────────────────────────────────────────────────────
var applyQA_CH4 = function(img) {
  return img
    .select('CH4_column_volume_mixing_ratio_dry_air')
    .updateMask(img.select('solar_zenith_angle').lt(70));
};

var applyQA_CO = function(img) {
  return img
    .select('CO_column_number_density')
    .updateMask(img.select('solar_zenith_angle').lt(70));
};

var applyQA_NO2 = function(img) {
  return img
    .select('tropospheric_NO2_column_number_density')
    .updateMask(img.select('cloud_fraction').lt(0.3));
};

var applyQA_HCHO = function(img) {
  return img
    .select('tropospheric_HCHO_column_number_density')
    .updateMask(img.select('cloud_fraction').lt(0.3));
};

// ── 3. LOAD & FILTER COLLECTIONS ─────────────────────────────────────────────
var ch4Col = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CH4')
  .filterBounds(roi).filterDate(CONFIG.startDate, CONFIG.endDate).map(applyQA_CH4);

var coCol = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CO')
  .filterBounds(roi).filterDate(CONFIG.startDate, CONFIG.endDate).map(applyQA_CO);

var no2Col = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_NO2')
  .filterBounds(roi).filterDate(CONFIG.startDate, CONFIG.endDate).map(applyQA_NO2);

var hchoCol = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_HCHO')
  .filterBounds(roi).filterDate(CONFIG.startDate, CONFIG.endDate).map(applyQA_HCHO);

// ── 4. COMPOSITES ─────────────────────────────────────────────────────────────
var ch4Mean  = ch4Col.mean().clip(roi);
var coMean   = coCol.mean().clip(roi);
var no2Mean  = no2Col.mean().clip(roi);
var hchoMean = hchoCol.mean().clip(roi);

// ── 5. VISUALISATION PARAMETERS ───────────────────────────────────────────────
var SPECTRAL = ['#313695','#4575b4','#74add1','#abd9e9','#e0f3f8',
                '#ffffbf','#fee090','#fdae61','#f46d43','#d73027','#a50026'];

var ch4Viz  = {min: 1750,  max: 1900,   palette: SPECTRAL};
var coViz   = {min: 0,     max: 0.05,   palette: SPECTRAL};
var no2Viz  = {min: 0,     max: 0.0002, palette: SPECTRAL};
var hchoViz = {min: 0,     max: 0.0003, palette: SPECTRAL};

// ── 6. ADD MAP LAYERS ──────────────────────────────────────────────────────────
Map.addLayer(ch4Mean,  ch4Viz,  'CH4 — Mean',  true);
Map.addLayer(coMean,   coViz,   'CO — Mean',   false);
Map.addLayer(no2Mean,  no2Viz,  'NO2 — Mean',  false);
Map.addLayer(hchoMean, hchoViz, 'HCHO — Mean', false);
Map.addLayer(
  ee.Image().byte().paint({featureCollection: ee.FeatureCollection([ee.Feature(roi)]), width: 2}),
  {palette: ['#ffffff']}, 'ROI boundary'
);

// ── 7. LEGEND BUILDER ─────────────────────────────────────────────────────────
var makeLegend = function(title, units, palette, minVal, maxVal, position) {
  var panel = ui.Panel({
    style: {position: position, padding: '8px 12px', backgroundColor: 'rgba(10,14,30,0.85)'}
  });
  panel.add(ui.Label({value: title, style: {fontWeight: 'bold', fontSize: '13px', color: 'black', margin: '0 0 2px 0'}}));
  panel.add(ui.Label({value: units, style: {fontSize: '10px', color: 'black', margin: '0 0 6px 0'}}));
  panel.add(ui.Thumbnail({
    image:  ee.Image.pixelLonLat().select(0).unitScale(0, 1).visualize({min: 0, max: 1, palette: palette}),
    params: {bbox: '0,0,1,0.1', dimensions: '180x16'},
    style:  {stretch: 'horizontal', margin: '0 0 4px 0'},
  }));
  panel.add(ui.Panel([
    ui.Label(String(minVal), {fontSize: '10px', color: 'black'}),
    ui.Label(String(maxVal), {fontSize: '10px', color: 'black', textAlign: 'right', stretch: 'horizontal'}),
  ], ui.Panel.Layout.flow('horizontal')));
  Map.add(panel);
};

makeLegend('CH₄ Methane',          'ppb',    SPECTRAL, 1750, 1900,   'bottom-left');
makeLegend('NO₂ Nitrogen Dioxide', 'mol/m²', SPECTRAL, 0,    0.0002, 'bottom-left');
makeLegend('CO Carbon Monoxide', 'mol/m²', SPECTRAL, 0, 0.05,   'bottom-left');
makeLegend('HCHO Formaldehlyde', 'mol/m²', SPECTRAL, 0,    0.0003, 'bottom-left');

// ── 8. DASHBOARD HEADER ────────────────────────────────────────────────────────
print('════════════════════════════════════════');
print('  ' + CONFIG.cityName + ' · Multi-Gas GHG Dashboard');
print('  Period: ' + CONFIG.startDate + ' → ' + CONFIG.endDate);
print('  CH4/CO QA: solar_zenith_angle < 70°');
print('  NO2/HCHO QA: cloud_fraction < 0.3');
print('════════════════════════════════════════');
print('Collection sizes after QA filter:');
print('  CH4  images:', ch4Col.size());
print('  CO   images:', coCol.size());
print('  NO2  images:', no2Col.size());
print('  HCHO images:', hchoCol.size());

// ── 9. CHART OPTIONS HELPER ───────────────────────────────────────────────────
var chartOpts = function(title, vAxisTitle, color) {
  return {
    title:     title,
    vAxis:     {title: vAxisTitle, titleTextStyle: {italic: false}},
    hAxis:     {title: 'Month', format: 'MMM yyyy', gridlines: {count: -1}},
    lineWidth: 2,
    pointSize: 5,
    colors:    [color],
    trendlines: {0: {type: 'linear', color: '#888888', lineWidth: 1, opacity: 0.6,
                     visibleInLegend: true, labelInLegend: 'Trend'}},
    chartArea: {width: '80%', height: '65%'},
    subtitle:  'Monthly mean · QA filtered · ' + (CONFIG.bufferMeters / 1000) + ' km buffer · ' + CONFIG.cityName,
  };
};

// ── 10. MONTHLY AGGREGATION HELPER ────────────────────────────────────────────
// Collapses daily images into one mean image per calendar month.
// Each output image is timestamped to the 1st of that month.
var toMonthly = function(col, bandName) {
  var start   = ee.Date(CONFIG.startDate);
  var end     = ee.Date(CONFIG.endDate);
  var nMonths = end.difference(start, 'month').round();
  var months  = ee.List.sequence(0, nMonths.subtract(1));
  var periodMean = col.mean(); // computed once, reused as last-resort fill
  return ee.ImageCollection(months.map(function(n) {
    var monthStart = start.advance(n, 'month');
    var monthEnd   = monthStart.advance(1, 'month');

    // Tier 1: exact calendar month
    var primary  = col.filterDate(monthStart, monthEnd).mean();

    // Tier 2: +-15 day window around mid-month
    var centre   = monthStart.advance(15, 'day');
    var fallback = col.filterDate(
      centre.advance(-15, 'day'),
      centre.advance(15, 'day')
    ).mean();

    // Tier 3: full period mean — ensures every month has a value
    var filled = primary.unmask(fallback).unmask(periodMean);

    return filled
      .set('system:time_start', monthStart.millis())
      .rename([bandName]);
  }));
};

var ch4Monthly  = toMonthly(ch4Col,  'CH4');
var coMonthly   = toMonthly(coCol,   'CO');
var no2Monthly  = toMonthly(no2Col,  'NO2');
var hchoMonthly = toMonthly(hchoCol, 'HCHO');

// ── 11. TIME-SERIES CHARTS (monthly) ──────────────────────────────────────────
print(ui.Chart.image.series(ch4Monthly,  roi, ee.Reducer.mean(), CONFIG.chartScale)
  .setOptions(chartOpts('METHANE (CH₄) — Warming Potential',           'ppb',    '#e74c3c')));

print(ui.Chart.image.series(coMonthly,   roi, ee.Reducer.mean(), CONFIG.chartScale)
  .setOptions(chartOpts('CARBON MONOXIDE (CO) — Combustion / Smog',    'mol/m²', '#e67e22')));

print(ui.Chart.image.series(no2Monthly,  roi, ee.Reducer.mean(), CONFIG.chartScale)
  .setOptions(chartOpts('NITROGEN DIOXIDE (NO₂) — Traffic / Industry', 'mol/m²', '#8e44ad')));

print(ui.Chart.image.series(hchoMonthly, roi, ee.Reducer.mean(), CONFIG.chartScale)
  .setOptions(chartOpts('FORMALDEHYDE (HCHO) — VOCs / Cancer Risk',    'mol/m²', '#27ae60')));

// ── 12. REGIONAL SUMMARY STATISTICS ───────────────────────────────────────────
var printStats = function(img, label, units) {
  var s = img.reduceRegion({
    reducer:   ee.Reducer.mean()
                 .combine(ee.Reducer.stdDev(), '', true)
                 .combine(ee.Reducer.minMax(), '', true),
    geometry:  roi,
    scale:     CONFIG.chartScale,
    maxPixels: 1e9,
  });
  print(label + ' regional stats (' + units + '):', s);
};

printStats(ch4Mean,  'CH4',  'ppb');
printStats(coMean,   'CO',   'mol/m²');
printStats(no2Mean,  'NO2',  'mol/m²');
printStats(hchoMean, 'HCHO', 'mol/m²');

print('✅ Dashboard loaded.');
