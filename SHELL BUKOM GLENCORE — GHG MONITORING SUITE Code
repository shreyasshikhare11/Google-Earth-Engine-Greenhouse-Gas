  [103.78762962166448, 1.245896845412889],
  [103.73166801277776, 1.2453819829807837]
]], null, false);

// 10 km buffer — guarantees TROPOMI pixel coverage over the ~3 km² island
var bukomBuffer10km = bukom.buffer(10000);
