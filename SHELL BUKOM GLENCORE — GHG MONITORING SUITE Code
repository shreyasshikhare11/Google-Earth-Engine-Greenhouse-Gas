function buildTimeSeriesChart(monthlyCol, band, gasLabel, units, threshold) {
  var series = monthlyCol.map(function(img) {
    var raw = img.reduceRegion({
      reducer:    ee.Reducer.mean(),
      geometry:   bukom,
      scale:      5000,
      maxPixels:  1e9,
      bestEffort: true
    }).get(band);

    var val = safeNum(raw, threshold);  // 2 args only

    return ee.Feature(null, {
      'Concentration':     val,
      'Threshold':         threshold,   // plain JS number — always defined
      'system:time_start': img.get('system:time_start')
    });
  });

  print(
    ui.Chart.feature.byFeature(series, 'system:time_start', ['Concentration', 'Threshold'])
      .setChartType('LineChart')
      .setSeriesNames(['Observed', 'Regulatory limit'])
      .setOptions({
        title: gasLabel + ' — Monthly Mean, Shell Bukom',
        hAxis: {title: 'Date', format: 'MMM yyyy', slantedText: true, slantedTextAngle: 45},
        vAxis: {title: gasLabel + ' (' + units + ')'},
        series: {
          0: {color: '#d73027', lineWidth: 2, pointSize: 3},
          1: {color: '#313695', lineWidth: 2, lineDashStyle: [8, 4], pointSize: 0}
        },
        interpolateNulls: false,
        legend: {position: 'top'},
        backgroundColor: '#ffffff',
        chartArea: {left: 90, top: 55, right: 30, bottom: 70},
        width: 900, height: 340,
        trendlines: {
          0: {type: 'linear', color: '#aaaaaa', lineWidth: 1.5,
              opacity: 0.6, visibleInLegend: true, labelInLegend: 'Linear trend'}
        }
      })
  );
}

