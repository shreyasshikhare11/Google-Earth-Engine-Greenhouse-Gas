// ============================================================
//  SECTION F — THRESHOLD EXCEEDANCE COUNTS
// ============================================================

function detectExceedances(monthlyCol, band, threshold, gasLabel, units) {
  var fc = monthlyCol.map(function(img) {
    var raw = img.reduceRegion({
      reducer:    ee.Reducer.mean(),
      geometry:   bukom,
      scale:      5000,
      maxPixels:  1e9,
      bestEffort: true
    }).get(band);

    var val = safeNum(raw, 0);  // 2 args only

    return ee.Feature(null, {
      'value':    val,
      'exceeded': val.gt(threshold).toInt(),
      'month':    img.get('month')
    });
  });

  var count = fc.filter(ee.Filter.eq('exceeded', 1)).size();
  print(gasLabel + ' months exceeding threshold (' + threshold + ' ' + units + '):', count);
}

