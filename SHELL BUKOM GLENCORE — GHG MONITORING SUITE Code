function buildAnomalyChart(monthlyCol, band, gasLabel, units) {
  // Regional baseline over the 50 km donut ring (excludes 10 km core)
  var regionalRaw = monthlyCol.mean().reduceRegion({
    reducer:    ee.Reducer.mean(),
    geometry:   bukom,
    scale:      5000,
    maxPixels:  1e9,
    bestEffort: true
  }).get(band);

  var regionalMean = safeNum(regionalRaw, 0);  // 2 args only

  var anomalySeries = monthlyCol.map(function(img) {
    var localRaw = img.reduceRegion({
      reducer:    ee.Reducer.mean(),
      geometry:   bukom,
      scale:      5000,
      maxPixels:  1e9,
      bestEffort: true
    }).get(band);

    var local = safeNum(localRaw, regionalMean); 
    return ee.Feature(null, {
      'Anomaly':           local.subtract(regionalMean),
      'system:time_start': img.get('system:time_start')
    });
  });

  print(
    ui.Chart.feature.byFeature(anomalySeries, 'system:time_start', 'Anomaly')
      .setChartType('ColumnChart')
      .setOptions({
        title: gasLabel + ' Anomaly (' + units + ') — 10 km Bukom Zone vs 50 km Regional Ring\n' +
               'Positive = industrial plume above regional background',
        hAxis: {title: 'Date', format: 'MMM yyyy', slantedText: true, slantedTextAngle: 45},
        vAxis: {
          title: 'Anomaly (' + units + ')',
          baselineColor: '#333333',
          gridlines: {color: '#dddddd'}
        },
        colors: ['#f46d43'],
        backgroundColor: '#fafafa',
        chartArea: {left: 90, top: 65, right: 30, bottom: 75},
        width: 900, height: 310,
        legend: {position: 'none'},
        bar: {groupWidth: '75%'}
      })
  );
}

