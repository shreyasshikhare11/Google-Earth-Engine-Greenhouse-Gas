// ── 2. STUDY PERIOD ──────────────────────────────────────────
var START = '2018-01-01';
var END   = '2026-03-01';

// ── 3. REGULATORY THRESHOLDS ─────────────────────────────────
var THRESHOLDS = {
  CH4: 1920,
  CO:  0.04,
  NO2: 0.0002,
  SO2: 0.0005
};

// ── 4. NULL-SAFE NUMBER HELPER ───────────────────────────────
// Takes exactly 2 arguments. Never pass a third.
function safeNum(val, fallback) {
  fallback = (fallback !== undefined) ? fallback : 0;
  return ee.Number(
    ee.Algorithms.If(
      ee.Algorithms.IsEqual(val, null),
      fallback,
      val
    )
  );
}

// ── 5. SAFE MONTHLY MEAN HELPER ──────────────────────────────
// Returns globalMean when the filtered collection is empty (0 images),
// preventing the 0-band vs 1-band unmask crash.
function safeMean(col, outBand, globalMean) {
  var size = col.size();
  var mean = col.mean().rename(outBand);
  // If collection is empty, mean() produces a 0-band image → use globalMean
  return ee.Image(
    ee.Algorithms.If(size.eq(0), globalMean, mean)
  );
}

// ============================================================
//  SECTION A — COLLECTIONS
// ============================================================

// ── CH4 (ppb, bias-corrected) ────────────────────────────────
// Uncertainty relaxed to 30% for tropical humid conditions.
// Hard bounds 1700–2200 ppb reject retrieval artefacts.
var colCH4 = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CH4')
  .filterBounds(bukomBuffer10km)
  .filterDate(START, END)
  .map(function(img) {
    var signal = img.select('CH4_column_volume_mixing_ratio_dry_air_bias_corrected');
    var uncert = img.select('CH4_column_volume_mixing_ratio_dry_air_uncertainty');
    var mask   = uncert.divide(signal).lt(0.3).and(signal.gt(1700)).and(signal.lt(2200));
    return signal
      .updateMask(mask)
      .rename('CH4_ppb')
      .copyProperties(img, ['system:time_start']);
  });

// ── CO (mol/m²) ──────────────────────────────────────────────
var colCO = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_CO')
  .filterBounds(bukom)
  .filterDate(START, END)
  .map(function(img) {
    var data = img.select('CO_column_number_density');
    var mask = data.gt(0).and(data.lt(1));
    return data
      .updateMask(mask)
      .rename('CO_mol_m2')
      .copyProperties(img, ['system:time_start']);
  });

// ── NO2 — tropospheric column (mol/m²) ───────────────────────
var colNO2 = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_NO2')
  .filterBounds(bukom)
  .filterDate(START, END)
  .map(function(img) {
    var data = img.select('tropospheric_NO2_column_number_density');
    var cf   = img.select('cloud_fraction');
    var mask = cf.lt(0.5).and(data.gt(-0.0001));
    return data
      .updateMask(mask)
      .rename('NO2_mol_m2')
      .copyProperties(img, ['system:time_start']);
  });

// ── SO2 — total column (mol/m²) ──────────────────────────────
var colSO2 = ee.ImageCollection('COPERNICUS/S5P/OFFL/L3_SO2')
  .filterBounds(bukom)
  .filterDate(START, END)
  .map(function(img) {
    var data = img.select('SO2_column_number_density');
    var cf   = img.select('cloud_fraction');
    var aai  = img.select('absorbing_aerosol_index');
    var mask = cf.lt(0.5).and(aai.lt(1.0));
    return data
      .updateMask(mask)
      .rename('SO2_mol_m2')
      .copyProperties(img, ['system:time_start']);
  });

// ============================================================
//  SECTION B — 3-TIER GAP-FILL MONTHLY AGGREGATION
// ============================================================

function toMonthly(col, outBand) {
  var globalMean = col.mean().rename(outBand);
  var nMonths = ee.Date(END).difference(ee.Date(START), 'month').round();
  var months  = ee.List.sequence(0, nMonths.subtract(1));

  var monthly = months.map(function(offset) {
    var monthStart = ee.Date(START).advance(offset, 'month');
    var monthEnd   = monthStart.advance(1, 'month');
    var midpoint   = monthStart.advance(15, 'day');

    // Tier 1 — strict calendar month (best quality)
    var col1 = col.filterDate(monthStart, monthEnd);
    var t1   = safeMean(col1, outBand, globalMean);

    // Tier 2 — ±15-day window around midpoint
    var col2 = col.filterDate(
      midpoint.advance(-15, 'day'),
      midpoint.advance( 15, 'day')
    );
    var t2 = safeMean(col2, outBand, globalMean);

    // Tier 3 — long-term period mean (always has 1 band, never empty)
    // .unmask() is now safe: both t1 and globalMean always have 1 band
    var filled = t1
      .unmask(t2)
      .unmask(globalMean);

    return filled
      .rename(outBand)
      .set('system:time_start', monthStart.millis())
      .set('month', monthStart.format('YYYY-MM'));
  });

  return ee.ImageCollection(monthly);
}

var mCH4 = toMonthly(colCH4, 'CH4_ppb');
var mCO  = toMonthly(colCO,  'CO_mol_m2');
var mNO2 = toMonthly(colNO2, 'NO2_mol_m2');
